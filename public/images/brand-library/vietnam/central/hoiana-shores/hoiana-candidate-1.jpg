.js" type="text/javascript"></script><script src="https://proxy.hoiana.com/https%3A%2F%2Fcdn.prod.website-files.com%2Fgsap%2F3.14.2%2FDraggable.min.js" type="text/javascript"></script><script type="text/javascript">gsap.registerPlugin(ScrollTrigger,Draggable);</script><script src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"></script> 

