<script>
  const lenis = new Lenis();
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => {lenis.raf(time * 1000);});
  gsap.ticker.lagSmoothing(0);
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const headers = document.querySelectorAll("header");

    window.addEventListener("scroll", () => {
      headers.forEach(header => {
        if (window.scrollY > 20) {
          header.classList.add("active");
        } else {
          header.classList.remove("active");
        }
      });
    });
  });
</script>

<script>
// Global parallax initialization function
function initGlobalParallax() {
  const mm = gsap.matchMedia();
  
  mm.add(
    {
      isMobile: "(max-width:479px)",
      isMobileLandscape: "(max-width:767px)",
      isTablet: "(max-width:991px)",
      isDesktop: "(min-width:992px)",
    },
    (context) => {
      const { isMobile, isMobileLandscape, isTablet } = context.conditions;
      
      const ctx = gsap.context(() => {
        // Find all elements with parallax trigger attribute
        document.querySelectorAll('[data-parallax="trigger"]').forEach((trigger) => {
          
          // Check if parallax should be disabled on current device
          const disable = trigger.getAttribute("data-parallax-disable");
          if (
            (disable === "mobile" && isMobile) ||
            (disable === "mobileLandscape" && isMobileLandscape) ||
            (disable === "tablet" && isTablet)
          ) return;
          
          // Get parallax configuration from data attributes
          const direction = trigger.getAttribute("data-parallax-direction") || "vertical";
          const prop = direction === "horizontal" ? "xPercent" : "yPercent";
          
          // Configure scrub animation
          const scrubAttr = trigger.getAttribute("data-parallax-scrub");
          const scrub = scrubAttr !== null
            ? (isNaN(parseFloat(scrubAttr)) ? true : parseFloat(scrubAttr))
            : true;
          
          // Set scroll trigger points
          const scrollStart = `clamp(${trigger.getAttribute("data-parallax-scroll-start") || "top bottom"})`;
          const scrollEnd   = `clamp(${trigger.getAttribute("data-parallax-scroll-end")   || "bottom top"})`;
          
          // Check if translation is enabled (this is where translate can be disabled)
          const translateEnabled = trigger.getAttribute("data-parallax-translate") !== "false";
          
          // Get translation values
          const startVal = trigger.hasAttribute("data-parallax-start") ? parseFloat(trigger.getAttribute("data-parallax-start")) : 20;
          const endVal   = trigger.hasAttribute("data-parallax-end")   ? parseFloat(trigger.getAttribute("data-parallax-end"))   : -20;
          
          // Get rotation configuration
          const hasRotateStart = trigger.hasAttribute("data-parallax-rotate-start");
          const hasRotateEnd   = trigger.hasAttribute("data-parallax-rotate-end");
          const rotateStart = hasRotateStart ? parseFloat(trigger.getAttribute("data-parallax-rotate-start")) : 0;
          const rotateEnd   = hasRotateEnd   ? parseFloat(trigger.getAttribute("data-parallax-rotate-end"))   : 0;
          const rotateOrigin = trigger.getAttribute("data-parallax-rotate-origin") || "50% 50%";
          
          // Build animation variables
          const fromVars = {};
          const toVars   = { ease: "none" };
          
          // Add translation properties only if enabled
          if (translateEnabled) {
            fromVars[prop] = startVal;
            toVars[prop]   = endVal;
          }
          
          // Add rotation properties if specified
          if (hasRotateStart || hasRotateEnd) {
            fromVars.rotate = rotateStart;
            toVars.rotate   = rotateEnd;
            gsap.set(trigger, { transformOrigin: rotateOrigin });
          }
          
          // Skip if no animation properties are defined
          if (!Object.keys(fromVars).length) return;
          
          // Create the parallax animation
          gsap.fromTo(trigger, fromVars, {
            ...toVars,
            scrollTrigger: {
              trigger,
              start: scrollStart,
              end:   scrollEnd,
              scrub,
            },
          });
        });
      });
      
      // Return cleanup function
      return () => ctx.revert();
    }
  );
}

// Initialize parallax when DOM is ready
document.addEventListener("DOMContentLoaded", () => {
  initGlobalParallax();
});
</script>

<script>
  document.addEventListener(
    "DOMContentLoaded", () => {
      const menu = new MmenuLight(
        document.querySelector( "#menu" )
      );

      const navigator = menu.navigation();
      const drawer = menu.offcanvas();
     
      document.querySelector( 'a[href="#menu"]' ).addEventListener( 'click', ( evnt ) => {
        evnt.preventDefault();
        drawer.open();
      });
    }
  );
</script>
</body></html>